data/raw/
data/private/
statements/
execution_logs/
*.log

# Python and editor artifacts
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/
.DS_Store
.idea/
.vscode/

# Additional experiment output
results/*/
!results/demo/
